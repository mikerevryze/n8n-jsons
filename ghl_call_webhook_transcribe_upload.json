      "id": "a1b2c3d4-0018-4000-8000-000000000018",
      "name": "Merge All Data"
    },
    {
      "parameters": {
        "jsCode": "// Build the filename and gather all needed data\nconst webhookData = $('Extract Webhook Data').first().json;\nconst contactData = $input.first().json;\n\n// Extract contact (lead) info\nconst contact = contactData.contact || contactData;\nconst leadFirstName = (contact.firstName || contact.first_name || 'unknown').toLowerCase().trim();\nconst leadLastName = (contact.lastName || contact.last_name || 'unknown').toLowerCase().trim();\n\n// Extract user (rep) info — may be nested differently after merge\nconst user = contactData.user || contactData;\nconst repFirstName = (user.firstName || user.first_name || contactData.name?.split(' ')[0] || 'unknown').toLowerCase().trim();\nconst repLastName = (user.lastName || user.last_name || contactData.name?.split(' ').slice(1).join(' ') || 'unknown').toLowerCase().trim();\n\n// Extract location/subaccount name\nconst location = contactData.location || contactData;\nconst subaccountName = location.name || contactData.name || 'Unknown Location';\n\n// Build date string\nconst callDate = new Date(webhookData.dateAdded);\nconst dateStr = callDate.toISOString().split('T')[0];\n\n// Build filename: repfirstname-replastname_leadfirstname-leadlastname_YYYY-MM-DD\nconst filename = `${repFirstName}-${repLastName}_${leadFirstName}-${leadLastName}_${dateStr}`;\n\n// Display names for transcript\nconst repFullName = `${repFirstName.charAt(0).toUpperCase() + repFirstName.slice(1)} ${repLastName.charAt(0).toUpperCase() + repLastName.slice(1)}`;\nconst leadFullName = `${leadFirstName.charAt(0).toUpperCase() + leadFirstName.slice(1)} ${leadLastName.charAt(0).toUpperCase() + leadLastName.slice(1)}`;\n\nreturn [{\n  json: {\n    filename,\n    repFullName,\n    leadFullName,\n    subaccountName,\n    recordingUrl: webhookData.recordingUrl,\n    contactId: webhookData.contactId,\n    userId: webhookData.userId,\n    locationId: webhookData.locationId,\n    dateStr\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1520, 0],
      "id": "a1b2c3d4-0007-4000-8000-000000000007",
      "name": "Build Filename & Names"
    },
