    {
      "parameters": {
        "jsCode": "// Extract fields from the GHL webhook payload\nconst body = $input.first().json.body || $input.first().json;\n\nconst contactId = body.contact_id || body.contactId || '';\nconst userId = body.user_id || body.userId || '';\nconst locationId = body.location_id || body.locationId || '';\nconst recordingUrl = body.recording_url || body.recordingUrl || '';\nconst callStatus = body.status || body.call_status || '';\nconst callDirection = body.direction || '';\nconst dateAdded = body.date_added || body.dateAdded || new Date().toISOString();\n\nif (!contactId) {\n  throw new Error('Missing contact_id in webhook payload');\n}\nif (!userId) {\n  throw new Error('Missing user_id in webhook payload');\n}\n\nreturn [{\n  json: {\n    contactId,\n    userId,\n    locationId,\n    recordingUrl,\n    callStatus,\n    callDirection,\n    dateAdded\n  }\n}];"
      },
