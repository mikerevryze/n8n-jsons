      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [3500, -200],
      "id": "a1b2c3d4-0014-4000-8000-000000000014",
      "name": "Create Drive Folder",
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "google_drive_credential",
          "name": "Google Drive OAuth2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// After creating the folder, set the folderId from the response\nconst createResult = $input.first().json;\nconst prevData = $('Check Folder Exists').first().json;\n\nreturn [{\n  json: {\n    folderId: createResult.id,\n    folderName: prevData.subaccountName,\n    filename: prevData.filename,\n    transcript: prevData.transcript,\n    subaccountName: prevData.subaccountName\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3720, -200],
      "id": "a1b2c3d4-0022-4000-8000-000000000022",
      "name": "Set New Folder ID"
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "combineAll",
        "options": {}
      },
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [3940, -100],
      "id": "a1b2c3d4-0023-4000-8000-000000000023",
      "name": "Merge Folder Result"
    },
    {
      "parameters": {
        "jsCode": "// Normalize the folder data from either path (existing or newly created)\nconst data = $input.first().json;\nconst folderId = data.folderId;\nconst filename = data.filename;\nconst transcript = data.transcript;\nconst subaccountName = data.subaccountName;\n\nreturn [{\n  json: {\n    folderId,\n    filename,\n    transcript,\n    subaccountName\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [4160, -100],
      "id": "a1b2c3d4-0024-4000-8000-000000000024",
      "name": "Normalize Folder Data"
    },
    {
      "parameters": {
        "name": "={{ $json.filename }}.mp3",
        "folderId": {
          "__rl": true,
          "value": "={{ $json.folderId }}",
          "mode": "id"
        },
        "inputDataFieldName": "recordingFile",
        "options": {}
      },
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [4380, -200],
      "id": "a1b2c3d4-0015-4000-8000-000000000015",
      "name": "Upload MP3 to Drive",
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "google_drive_credential",
          "name": "Google Drive OAuth2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Convert the transcript text into a binary .txt file for upload\nconst data = $('Normalize Folder Data').first().json;\nconst transcript = data.transcript;\nconst filename = data.filename;\nconst folderId = data.folderId;\n\nconst buffer = Buffer.from(transcript, 'utf-8');\n\nreturn [{\n  json: {\n    filename,\n    folderId\n  },\n  binary: {\n    transcriptFile: {\n      data: buffer.toString('base64'),\n      mimeType: 'text/plain',\n      fileName: `${filename}.txt`\n    }\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [4380, 0],
      "id": "a1b2c3d4-0025-4000-8000-000000000025",
      "name": "Create Transcript File"
    },
    {
      "parameters": {
        "name": "={{ $json.filename }}.txt",
        "folderId": {
          "__rl": true,
          "value": "={{ $json.folderId }}",
          "mode": "id"
        },
        "inputDataFieldName": "transcriptFile",
        "options": {}
      },
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [4600, 0],
      "id": "a1b2c3d4-0026-4000-8000-000000000026",
      "name": "Upload Transcript to Drive",
      "credentials": {
