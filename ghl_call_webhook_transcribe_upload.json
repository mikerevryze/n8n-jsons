    },
    {
      "parameters": {
        "jsCode": "console.log('Transcription failed or returned empty. Skipping transcript upload.');\nconst fileData = $('Build Filename & Names').first().json;\nreturn [{\n  json: {\n    status: 'error',\n    reason: 'Transcription failed or returned no words',\n    filename: fileData.filename,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2400, 200],
      "id": "a1b2c3d4-0011-4000-8000-000000000011",
      "name": "Log Transcription Error"
    },
    {
      "parameters": {
        "jsCode": "// Format the ElevenLabs Scribe transcript into clean timestamped dialogue\nconst transcriptionData = $('Transcribe with ElevenLabs').first().json;\nconst fileData = $('Build Filename & Names').first().json;\nconst repFullName = fileData.repFullName;\nconst leadFullName = fileData.leadFullName;\n\nconst words = transcriptionData.words || [];\n\nif (words.length === 0) {\n  return [{ json: { transcript: '(No speech detected)', filename: fileData.filename } }];\n}\n\n// Group words into utterances by speaker changes\nconst utterances = [];\nlet currentSpeaker = null;\nlet currentWords = [];\nlet currentStart = 0;\n\nfor (const word of words) {\n  const speaker = word.speaker_id !== undefined ? word.speaker_id : (word.speaker ?? null);\n  \n  if (speaker !== currentSpeaker && currentWords.length > 0) {\n    utterances.push({\n      speaker: currentSpeaker,\n      text: currentWords.join(' '),\n      start: currentStart\n    });\n    currentWords = [];\n  }\n  \n  if (currentWords.length === 0) {\n    currentStart = word.start_time || word.start || 0;\n    currentSpeaker = speaker;\n  }\n  \n  currentWords.push(word.text || word.word || '');\n}\n\n// Push last utterance\nif (currentWords.length > 0) {\n  utterances.push({\n    speaker: currentSpeaker,\n    text: currentWords.join(' '),\n    start: currentStart\n  });\n}\n\n// Format timestamp as [HH:MM:SS]\nfunction formatTime(seconds) {\n  const h = Math.floor(seconds / 3600).toString().padStart(2, '0');\n  const m = Math.floor((seconds % 3600) / 60).toString().padStart(2, '0');\n  const s = Math.floor(seconds % 60).toString().padStart(2, '0');\n  return `[${h}:${m}:${s}]`;\n}\n\n// Build formatted transcript\n// Speaker 0 = Rep, Speaker 1 = Lead\nconst lines = utterances.map(u => {\n  const speakerNum = parseInt(u.speaker, 10);\n  let label;\n  if (speakerNum === 0) {\n    label = `Rep (${repFullName})`;\n  } else if (speakerNum === 1) {\n    label = `Lead (${leadFullName})`;\n  } else {\n    label = `Speaker ${u.speaker}`;\n  }\n  return `${formatTime(u.start)} ${label}: ${u.text.trim()}`;\n});\n\nconst transcript = lines.join('\\n');\n\nreturn [{\n  json: {\n    transcript,\n    filename: fileData.filename,\n    subaccountName: fileData.subaccountName\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2400, -100],
      "id": "a1b2c3d4-0012-4000-8000-000000000012",
      "name": "Format Transcript"
    },
    {
      "parameters": {
        "jsCode": "// Search for a folder with the subaccount name in Google Drive\n// This node outputs the subaccount name so the next nodes can use it\nconst fileData = $('Build Filename & Names').first().json;\nconst transcript = $('Format Transcript').first().json.transcript;\n\nreturn [{\n  json: {\n    filename: fileData.filename,\n    subaccountName: fileData.subaccountName,\n    transcript\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2620, -100],
      "id": "a1b2c3d4-0019-4000-8000-000000000019",
      "name": "Prepare Upload Data"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://www.googleapis.com/drive/v3/files",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleDriveOAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "=mimeType='application/vnd.google-apps.folder' and name='{{ $json.subaccountName }}' and trashed=false"
            },
            {
              "name": "fields",
              "value": "files(id,name)"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2840, -100],
      "id": "a1b2c3d4-0013-4000-8000-000000000013",
      "name": "Search Drive Folder",
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "google_drive_credential",
          "name": "Google Drive OAuth2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Check if the folder was found; if not, create it\nconst searchResult = $input.first().json;\nconst files = searchResult.files || [];\nconst uploadData = $('Prepare Upload Data').first().json;\n\nif (files.length > 0) {\n  // Folder exists\n  return [{\n    json: {\n      folderId: files[0].id,\n      folderName: files[0].name,\n      filename: uploadData.filename,\n      transcript: uploadData.transcript,\n      subaccountName: uploadData.subaccountName,\n      needsCreation: false\n    }\n  }];\n} else {\n  // Folder does not exist, flag for creation\n  return [{\n    json: {\n      folderId: null,\n      folderName: uploadData.subaccountName,\n      filename: uploadData.filename,\n      transcript: uploadData.transcript,\n      subaccountName: uploadData.subaccountName,\n      needsCreation: true\n    }\n  }];\n}"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3060, -100],
      "id": "a1b2c3d4-0020-4000-8000-000000000020",
      "name": "Check Folder Exists"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-folder-exists",
              "leftValue": "={{ $json.needsCreation }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [3280, -100],
      "id": "a1b2c3d4-0021-4000-8000-000000000021",
      "name": "Folder Needs Creation?"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://www.googleapis.com/drive/v3/files",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleDriveOAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ name: $json.subaccountName, mimeType: 'application/vnd.google-apps.folder' }) }}",
        "options": {}
