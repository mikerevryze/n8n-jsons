    {
      "parameters": {
        "jsCode": "// Filter messages to only TYPE_CALL and output each as a separate item\nconst response = $input.first().json;\nconst messages = response.messages || response.data || [];\nconst conversationId = $('Loop Conversations').first().json.conversationId;\nconst contactId = $('Loop Conversations').first().json.contactId;\nconst contactName = $('Loop Conversations').first().json.contactName;\n\nconst callMessages = messages.filter(msg => \n  msg.type === 'TYPE_CALL' || \n  msg.type === 'call' || \n  msg.messageType === 'TYPE_CALL'\n);\n\nif (callMessages.length === 0) {\n  // Return empty signal so we skip to next conversation\n  return [{\n    json: {\n      hasCallMessages: false,\n      conversationId,\n      contactId\n    }\n  }];\n}\n\n// Output each call message as a separate item\nreturn callMessages.map(msg => ({\n  json: {\n    hasCallMessages: true,\n    messageId: msg.id,\n    conversationId,\n    contactId,\n    contactName,\n    messageType: msg.type || msg.messageType,\n    direction: msg.direction || '',\n    status: msg.status || '',\n    dateAdded: msg.dateAdded || msg.createdAt || '',\n    body: msg.body || '',\n    locationId: '9oW28j2SxdPAmUhO5MDI'\n  }\n}));"
      },
