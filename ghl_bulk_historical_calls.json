    {
      "parameters": {
        "jsCode": "const fileData = $('Build Filename & Names').first().json;\nreturn [{\n  json: {\n    status: 'error',\n    reason: 'Transcription failed or returned no words',\n    filename: fileData.filename,\n    messageId: fileData.messageId,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
