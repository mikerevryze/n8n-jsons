      "parameters": {
        "jsCode": "// Extract the recording URL from the response\nconst response = $input.first().json;\nconst callData = $('Loop Call Messages').first().json;\n\n// The recording endpoint may return a URL directly or nested\nconst recordingUrl = response.url || response.recordingUrl || response.recording_url || response.data?.url || '';\nconst status = response.status || '';\n\nreturn [{\n  json: {\n    messageId: callData.messageId,\n    conversationId: callData.conversationId,\n    contactId: callData.contactId,\n    contactName: callData.contactName,\n    direction: callData.direction,\n    callStatus: callData.status,\n    dateAdded: callData.dateAdded,\n    locationId: callData.locationId,\n    recordingUrl,\n    recordingStatus: status\n  }\n}];"
