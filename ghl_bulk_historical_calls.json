      "position": [4180, 300],
      "id": "b1000001-0020-4000-8000-000000000020",
      "name": "Log Transcription Error"
    },
    {
      "parameters": {
        "jsCode": "// Format the ElevenLabs Scribe transcript into clean timestamped dialogue\nconst transcriptionData = $('Transcribe with ElevenLabs').first().json;\nconst fileData = $('Build Filename & Names').first().json;\nconst leadFullName = fileData.leadFullName;\n\nconst words = transcriptionData.words || [];\n\nif (words.length === 0) {\n  return [{ json: { transcript: '(No speech detected)', filename: fileData.filename } }];\n}\n\n// Group words into utterances by speaker changes\nconst utterances = [];\nlet currentSpeaker = null;\nlet currentWords = [];\nlet currentStart = 0;\n\nfor (const word of words) {\n  const speaker = word.speaker_id !== undefined ? word.speaker_id : (word.speaker ?? null);\n  \n  if (speaker !== currentSpeaker && currentWords.length > 0) {\n    utterances.push({\n      speaker: currentSpeaker,\n      text: currentWords.join(' '),\n      start: currentStart\n    });\n    currentWords = [];\n  }\n  \n  if (currentWords.length === 0) {\n    currentStart = word.start_time || word.start || 0;\n    currentSpeaker = speaker;\n  }\n  \n  currentWords.push(word.text || word.word || '');\n}\n\nif (currentWords.length > 0) {\n  utterances.push({\n    speaker: currentSpeaker,\n    text: currentWords.join(' '),\n    start: currentStart\n  });\n}\n\nfunction formatTime(seconds) {\n  const h = Math.floor(seconds / 3600).toString().padStart(2, '0');\n  const m = Math.floor((seconds % 3600) / 60).toString().padStart(2, '0');\n  const s = Math.floor(seconds % 60).toString().padStart(2, '0');\n  return `[${h}:${m}:${s}]`;\n}\n\n// Speaker 0 = Rep, Speaker 1 = Lead\nconst lines = utterances.map(u => {\n  const speakerNum = parseInt(u.speaker, 10);\n  let label;\n  if (speakerNum === 0) {\n    label = 'Rep';\n  } else if (speakerNum === 1) {\n    label = `Lead (${leadFullName})`;\n  } else {\n    label = `Speaker ${u.speaker}`;\n  }\n  return `${formatTime(u.start)} ${label}: ${u.text.trim()}`;\n});\n\nconst transcript = lines.join('\\n');\n\nreturn [{\n  json: {\n    transcript,\n    filename: fileData.filename,\n    subaccountName: fileData.subaccountName\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
