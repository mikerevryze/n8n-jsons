    {
      "parameters": {
        "jsCode": "const fileData = $('Build Filename & Names').first().json;\nconst transcript = $('Format Transcript').first().json.transcript;\n\nreturn [{\n  json: {\n    filename: fileData.filename,\n    subaccountName: fileData.subaccountName,\n    transcript\n  }\n}];"
