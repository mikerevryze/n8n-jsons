    {
      "parameters": {
        "jsCode": "// Build filename and gather all needed data for this call\nconst mergedData = $input.first().json;\nconst callData = $('Has Recording URL?').first().json;\n\n// Extract contact (lead) info\nconst contact = mergedData.contact || mergedData;\nconst leadFirstName = (contact.firstName || contact.first_name || 'unknown').toLowerCase().trim();\nconst leadLastName = (contact.lastName || contact.last_name || 'unknown').toLowerCase().trim();\n\n// Extract location/subaccount name\nconst location = mergedData.location || mergedData;\nconst subaccountName = location.name || 'Unknown Location';\n\n// Build date string from the call message date\nconst callDate = new Date(callData.dateAdded || new Date());\nconst dateStr = callDate.toISOString().split('T')[0];\n\n// For bulk historical, we don't have user/rep info from the message directly\n// Use direction as a proxy or set as 'rep'\nconst repLabel = 'rep';\n\n// Build filename: rep_leadfirstname-leadlastname_YYYY-MM-DD_messageId\nconst filename = `${repLabel}_${leadFirstName}-${leadLastName}_${dateStr}_${callData.messageId.slice(-6)}`;\n\nconst leadFullName = `${leadFirstName.charAt(0).toUpperCase() + leadFirstName.slice(1)} ${leadLastName.charAt(0).toUpperCase() + leadLastName.slice(1)}`;\n\nreturn [{\n  json: {\n    filename,\n    leadFullName,\n    subaccountName,\n    recordingUrl: callData.recordingUrl,\n    contactId: callData.contactId,\n    messageId: callData.messageId,\n    conversationId: callData.conversationId,\n    locationId: callData.locationId,\n    direction: callData.direction,\n    dateStr\n  }\n}];"
      },
