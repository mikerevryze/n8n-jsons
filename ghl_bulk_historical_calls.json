        "jsCode": "// Extract conversations array from the search response\nconst response = $input.first().json;\nconst conversations = response.conversations || [];\n\nif (conversations.length === 0) {\n  throw new Error('No conversations found for this location.');\n}\n\n// Output each conversation as a separate item for the loop\nreturn conversations.map(conv => ({\n  json: {\n    conversationId: conv.id,\n    contactId: conv.contactId || '',\n    locationId: '9oW28j2SxdPAmUhO5MDI',\n    contactName: conv.contactName || conv.fullName || '',\n    lastMessageDate: conv.lastMessageDate || '',\n    type: conv.type || ''\n  }\n}));"
