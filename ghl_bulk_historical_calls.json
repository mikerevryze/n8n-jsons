    {
      "parameters": {
        "jsCode": "const searchResult = $input.first().json;\nconst files = searchResult.files || [];\nconst uploadData = $('Prepare Upload Data').first().json;\n\nif (files.length > 0) {\n  return [{\n    json: {\n      folderId: files[0].id,\n      folderName: files[0].name,\n      filename: uploadData.filename,\n      transcript: uploadData.transcript,\n      subaccountName: uploadData.subaccountName,\n      needsCreation: false\n    }\n  }];\n} else {\n  return [{\n    json: {\n      folderId: null,\n      folderName: uploadData.subaccountName,\n      filename: uploadData.filename,\n      transcript: uploadData.transcript,\n      subaccountName: uploadData.subaccountName,\n      needsCreation: true\n    }\n  }];\n}"
      },
