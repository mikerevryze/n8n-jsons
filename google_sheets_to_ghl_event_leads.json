    {
      "parameters": {
        "jsCode": "const error = $input.first().json;\nconst leadData = $('Map Lead Fields').first().json;\nconst leadName = `${leadData.firstName} ${leadData.lastName}`;\nconst errorDetail = error.message || error.body || JSON.stringify(error);\n\nconsole.error(`Failed for ${leadName} (${leadData.email}): ${errorDetail}`);\n\nreturn [{\n  json: {\n    success: false,\n    error: errorDetail,\n    leadEmail: leadData.email,\n    leadName,\n    message: `Failed to process lead: ${leadName}`\n  }\n}];"
      },
