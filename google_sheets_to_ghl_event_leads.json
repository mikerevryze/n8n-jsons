{
  "name": "Google_Sheets_To_GHL_Event_Leads",
  "nodes": [
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "documentId": {
          "__rl": true,
          "value": "",
          "mode": "list",
          "cachedResultName": ""
        },
        "sheetName": {
          "__rl": true,
          "value": "",
          "mode": "list",
          "cachedResultName": ""
        },
        "event": "rowAdded",
        "options": {}
      },
      "type": "n8n-nodes-base.googleSheetsTrigger",
      "typeVersion": 1,
      "position": [220, 300],
      "id": "b2c3d4e5-0001-4000-8000-000000000001",
      "name": "Google Sheets Trigger",
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "",
          "name": ""
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Map Google Form/Sheet columns to GHL contact fields\n// Update the field names below to match your Google Sheet column headers\nconst row = $input.first().json;\n\nconst firstName = row['First Name'] || row['first_name'] || row['firstName'] || '';\nconst lastName = row['Last Name'] || row['last_name'] || row['lastName'] || '';\nconst email = row['Email'] || row['email'] || row['Email Address'] || '';\nconst phone = row['Phone'] || row['phone'] || row['Phone Number'] || '';\nconst eventName = row['Event Name'] || row['event_name'] || row['Event'] || '';\nconst notes = row['Notes'] || row['notes'] || row['Comments'] || '';\nconst timestamp = row['Timestamp'] || row['timestamp'] || new Date().toISOString();\n\nif (!email && !phone) {\n  throw new Error('Lead must have at least an email or phone number');\n}\n\nreturn [{\n  json: {\n    firstName,\n    lastName,\n    email,\n    phone,\n    eventName,\n    notes,\n    timestamp,\n    source: 'Google Form - Event Lead'\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300],
      "id": "b2c3d4e5-0002-4000-8000-000000000002",
      "name": "Map Lead Fields"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://services.leadconnectorhq.com/contacts/",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ \"firstName\": $json.firstName, \"lastName\": $json.lastName, \"email\": $json.email, \"phone\": $json.phone, \"locationId\": \"YOUR_GHL_LOCATION_ID\", \"source\": $json.source, \"tags\": [\"event-lead\", $json.eventName], \"customFields\": [{ \"key\": \"event_name\", \"field_value\": $json.eventName }, { \"key\": \"event_notes\", \"field_value\": $json.notes }, { \"key\": \"form_submitted_at\", \"field_value\": $json.timestamp }] }) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Version",
              "value": "2021-07-28"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 300],
      "id": "b2c3d4e5-0003-4000-8000-000000000003",
      "name": "Create GHL Contact",
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "GHL API Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Extract the contact ID from the Create Contact response\nconst response = $input.first().json;\nconst contactId = response.contact?.id || response.id;\nconst leadData = $('Map Lead Fields').first().json;\n\nif (!contactId) {\n  throw new Error('Failed to get contact ID from GHL response');\n}\n\nreturn [{\n  json: {\n    contactId,\n    firstName: leadData.firstName,\n    lastName: leadData.lastName,\n    email: leadData.email,\n    eventName: leadData.eventName,\n    source: leadData.source\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [940, 300],
      "id": "b2c3d4e5-0007-4000-8000-000000000007",
      "name": "Extract Contact ID"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://services.leadconnectorhq.com/opportunities/",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ \"pipelineId\": \"YOUR_PIPELINE_ID\", \"pipelineStageId\": \"YOUR_STAGE_ID\", \"locationId\": \"YOUR_GHL_LOCATION_ID\", \"contactId\": $json.contactId, \"name\": ($json.firstName || '') + ' ' + ($json.lastName || '') + ' - ' + ($json.eventName || 'Event Lead'), \"source\": $json.source, \"status\": \"open\" }) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Version",
              "value": "2021-07-28"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1180, 300],
      "id": "b2c3d4e5-0008-4000-8000-000000000008",
      "name": "Add to Pipeline",
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "GHL API Key"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-success-check",
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": "400",
              "operator": {
                "type": "number",
                "operation": "lt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1420, 300],
      "id": "b2c3d4e5-0004-4000-8000-000000000004",
      "name": "Check Success"
    },
    {
      "parameters": {
        "jsCode": "const opportunity = $input.first().json;\nconst contactId = $('Extract Contact ID').first().json.contactId;\nconst oppId = opportunity.opportunity?.id || opportunity.id || 'unknown';\n\nconsole.log(`Successfully created GHL contact ${contactId} and opportunity ${oppId}`);\n\nreturn [{\n  json: {\n    success: true,\n    contactId,\n    opportunityId: oppId,\n    message: `Lead created and added to pipeline: ${$('Extract Contact ID').first().json.firstName} ${$('Extract Contact ID').first().json.lastName}`\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1660, 200],
      "id": "b2c3d4e5-0005-4000-8000-000000000005",
      "name": "Log Success"
    },
    {
      "parameters": {
        "jsCode": "const error = $input.first().json;\nconst leadData = $('Map Lead Fields').first().json;\nconst leadName = `${leadData.firstName} ${leadData.lastName}`;\n\nconsole.error(`Failed for ${leadName} (${leadData.email})`);\nconsole.error(JSON.stringify(error, null, 2));\n\nreturn [{\n  json: {\n    success: false,\n    error: error.body || error,\n    leadEmail: leadData.email,\n    leadName,\n    message: `Failed to process lead: ${leadName}`\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1660, 400],
      "id": "b2c3d4e5-0006-4000-8000-000000000006",
      "name": "Log Error"
    }
  ],
