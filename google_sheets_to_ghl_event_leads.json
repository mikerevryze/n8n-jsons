    {
      "parameters": {
        "jsCode": "const opportunity = $input.first().json;\nconst contactData = $('Extract Contact ID').first().json;\nconst oppId = opportunity.opportunity?.id || opportunity.id || 'unknown';\nconst action = contactData.isNewContact ? 'Created new' : 'Updated existing';\n\nconsole.log(`${action} GHL contact ${contactData.contactId} and opportunity ${oppId}`);\n\nreturn [{\n  json: {\n    success: true,\n    contactId: contactData.contactId,\n    isNewContact: contactData.isNewContact,\n    opportunityId: oppId,\n    message: `${action} lead and added to pipeline: ${contactData.firstName} ${contactData.lastName}`\n  }\n}];"
      },
