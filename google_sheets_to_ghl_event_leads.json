        "event": "rowAdded",
        "options": {}
      },
      "type": "n8n-nodes-base.googleSheetsTrigger",
      "typeVersion": 1,
      "position": [220, 300],
      "id": "b2c3d4e5-0001-4000-8000-000000000001",
      "name": "Google Sheets Trigger",
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "",
          "name": ""
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Map Google Form/Sheet columns to GHL contact fields\n// Update the field names below to match your Google Sheet column headers\nconst row = $input.first().json;\n\nconst firstName = row['First Name'] || row['first_name'] || row['firstName'] || '';\nconst lastName = row['Last Name'] || row['last_name'] || row['lastName'] || '';\nconst email = row['Email'] || row['email'] || row['Email Address'] || '';\nconst phone = row['Phone'] || row['phone'] || row['Phone Number'] || '';\nconst eventName = row['Event Name'] || row['event_name'] || row['Event'] || '';\nconst notes = row['Notes'] || row['notes'] || row['Comments'] || '';\nconst timestamp = row['Timestamp'] || row['timestamp'] || new Date().toISOString();\n\nif (!email && !phone) {\n  throw new Error('Lead must have at least an email or phone number');\n}\n\nreturn [{\n  json: {\n    firstName,\n    lastName,\n    email,\n    phone,\n    eventName,\n    notes,\n    timestamp,\n    source: 'Google Form - Event Lead'\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300],
      "id": "b2c3d4e5-0002-4000-8000-000000000002",
      "name": "Map Lead Fields"
    },
    {
      "parameters": {
        "requestMethod": "POST",
        "url": "https://services.leadconnectorhq.com/contacts/",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "bodyContentType": "json"
        },
        "jsonParameters": true,
        "bodyParametersJson": "={{ JSON.stringify({ \"firstName\": $json.firstName, \"lastName\": $json.lastName, \"email\": $json.email, \"phone\": $json.phone, \"locationId\": \"YOUR_GHL_LOCATION_ID\", \"source\": $json.source, \"tags\": [\"event-lead\", $json.eventName], \"customFields\": [{ \"key\": \"event_name\", \"field_value\": $json.eventName }, { \"key\": \"event_notes\", \"field_value\": $json.notes }, { \"key\": \"form_submitted_at\", \"field_value\": $json.timestamp }] }) }}"
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 200],
      "id": "b2c3d4e5-0003-4000-8000-000000000003",
      "name": "Create GHL Contact",
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "GHL API Key"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-success-check",
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": "400",
              "operator": {
                "type": "number",
                "operation": "lt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [940, 200],
      "id": "b2c3d4e5-0004-4000-8000-000000000004",
      "name": "Check Success"
    },
    {
      "parameters": {
        "jsCode": "const contact = $input.first().json;\nconst contactId = contact.body?.contact?.id || contact.body?.id || 'unknown';\n\nconsole.log(`Successfully created GHL contact: ${contactId}`);\n\nreturn [{\n  json: {\n    success: true,\n    contactId,\n    message: `Lead created in GHL: ${$('Map Lead Fields').first().json.firstName} ${$('Map Lead Fields').first().json.lastName}`\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1180, 100],
      "id": "b2c3d4e5-0005-4000-8000-000000000005",
      "name": "Log Success"
    },
    {
      "parameters": {
        "jsCode": "const error = $input.first().json;\nconst leadEmail = $('Map Lead Fields').first().json.email;\nconst leadName = `${$('Map Lead Fields').first().json.firstName} ${$('Map Lead Fields').first().json.lastName}`;\n\nconsole.error(`Failed to create GHL contact for ${leadName} (${leadEmail})`);\nconsole.error(JSON.stringify(error, null, 2));\n\nreturn [{\n  json: {\n    success: false,\n    error: error.body || error,\n    leadEmail,\n    leadName,\n    message: `Failed to create lead: ${leadName}`\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1180, 300],
      "id": "b2c3d4e5-0006-4000-8000-000000000006",
      "name": "Log Error"
    }
  ],
