    {
      "parameters": {
        "jsCode": "// Map Google Form/Sheet columns to GHL contact fields\nconst row = $input.first().json;\n\nconst firstName = row['First Name'] || row['first_name'] || row['firstName'] || '';\nconst lastName = row['Last Name'] || row['last_name'] || row['lastName'] || '';\nconst email = (row['Email'] || row['email'] || row['Email Address'] || '').toString().trim().toLowerCase();\nconst rawPhone = String(row['Phone'] || row['phone'] || row['Phone Number'] || '');\nconst phone = rawPhone.replace(/[^\\d+]/g, '');\nconst eventName = row['Event Name'] || row['event_name'] || row['Event'] || '';\nconst notes = row['Notes'] || row['notes'] || row['Comments'] || '';\nconst timestamp = row['Timestamp'] || row['timestamp'] || new Date().toISOString();\n\nif (!email && !phone) {\n  throw new Error('Lead must have at least an email or phone number');\n}\n\nreturn [{\n  json: {\n    firstName,\n    lastName,\n    email,\n    phone,\n    eventName,\n    notes,\n    timestamp,\n    source: 'Google Form - Event Lead'\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2000,
        512
      ],
      "id": "df78401a-c9ef-4fb7-bea7-5511db6d874d",
      "name": "Map Lead Fields"
    },
    {
      "parameters": {
