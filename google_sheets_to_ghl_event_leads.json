    {
      "parameters": {
        "jsCode": "// Extract the contact ID from the upsert response\n// Upsert returns { contact: { id, ... }, new: true/false }\nconst response = $input.first().json;\nconst contactId = response.contact?.id || response.id;\nconst isNew = response.new !== undefined ? response.new : true;\nconst leadData = $('Map Lead Fields').first().json;\n\nif (!contactId) {\n  throw new Error('Failed to get contact ID from GHL response: ' + JSON.stringify(response));\n}\n\nreturn [{\n  json: {\n    contactId,\n    isNewContact: isNew,\n    firstName: leadData.firstName,\n    lastName: leadData.lastName,\n    email: leadData.email,\n    eventName: leadData.eventName,\n    source: leadData.source\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1520,
        400
      ],
      "id": "c1a1b2c3-0001-4000-8000-000000000001",
